{
  "expo": {
    "name": "Hayatus Sahaba",
    "slug": "hayatus-sahaba",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a0a00"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hayatussahaba.app",
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "com.hayatussahaba.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a0a00"
      }
    },
    "plugins": [
      "expo-router",
      "expo-av"
    ],
    "scheme": "hayatussahaba"
  }
}
